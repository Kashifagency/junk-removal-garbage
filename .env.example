# The only environment variable the site needs. On Vercel, add it under
# Project → Settings → Environment Variables. Locally, copy this file to .env.local.
#
# Resend API key for the contact form (/api/quote/). Emails are sent from Resend's shared
# sender (onboarding@resend.dev) to the email address the Resend account is registered with.
# No domain verification is needed.
RESEND_API_KEY=
