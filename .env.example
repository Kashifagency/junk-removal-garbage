# The only environment variable the site needs. On Vercel, add it under
# Project → Settings → Environment Variables. Locally, copy this file to .env.local.
#
# Resend API key for the quote form (/api/quote/). Enquiries are sent to the business email shown on
# the site, from quotes@junkremovalgarbage.com (junkremovalgarbage.com must be verified in Resend).
RESEND_API_KEY=
