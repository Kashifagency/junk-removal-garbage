# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# Public site URL used for canonical URLs, sitemap and structured data (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://junkremovalgarbage.com

# Quote/contact form (/api/quote/) sends enquiries through Resend (https://resend.com).
# If RESEND_API_KEY or QUOTE_TO_EMAIL is missing, the form asks visitors to call or WhatsApp instead.
RESEND_API_KEY=
# Inbox(es) that receive enquiries; comma-separate several addresses.
QUOTE_TO_EMAIL=
# Sender. Must use a domain verified in Resend, e.g. "Shanan Junk Removal <quotes@junkremovalgarbage.com>".
# Without a verified domain, Resend only allows onboarding@resend.dev sending to your own Resend account email.
QUOTE_FROM_EMAIL=

# Optional: Google Analytics 4 measurement ID (e.g. G-XXXXXXX).
NEXT_PUBLIC_GA_ID=
# Optional: Google Search Console verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Set to true on non-production deployments to block crawling via robots.txt.
NEXT_PUBLIC_NOINDEX=
